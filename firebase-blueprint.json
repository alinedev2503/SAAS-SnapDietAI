{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil e restrições alimentares do usuário autenticado",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "dietaryRestrictions": { "type": "array" },
        "targetCalories": { "type": "number" },
        "targetProtein": { "type": "number" },
        "targetCarbs": { "type": "number" },
        "targetFat": { "type": "number" },
        "targetSodium": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email"]
    },
    "ProductScan": {
      "title": "ProductScan",
      "description": "Leitura e análise nutricional de produto por IA com auditoria TACO",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "barcode": { "type": "string", "maxLength": 64 },
        "productName": { "type": "string", "maxLength": 200 },
        "brand": { "type": "string", "maxLength": 100 },
        "servingSize": { "type": "string", "maxLength": 100 },
        "healthScore": { "type": "number" },
        "nutriScore": { "type": "string", "maxLength": 5 },
        "novaGroup": { "type": "number" },
        "novaDescription": { "type": "string", "maxLength": 255 },
        "macronutrients": { "type": "object" },
        "ingredientsText": { "type": "string", "maxLength": 5000 },
        "beneficialSubstances": { "type": "array" },
        "harmfulSubstances": { "type": "array" },
        "additives": { "type": "array" },
        "triggeredAlerts": { "type": "array" },
        "suggestedSwaps": { "type": "array" },
        "tacoReference": { "type": "string", "maxLength": 200 },
        "tacoValidation": { "type": "object" },
        "scannedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "productName", "healthScore", "nutriScore"]
    },
    "DailyLog": {
      "title": "DailyLog",
      "description": "Consolidado diário de calorias e macronutrientes do usuário",
      "type": "object",
      "properties": {
        "date": { "type": "string", "maxLength": 20 },
        "totalCalories": { "type": "number" },
        "totalProtein": { "type": "number" },
        "totalCarbs": { "type": "number" },
        "totalFat": { "type": "number" },
        "totalSodium": { "type": "number" },
        "scanCount": { "type": "number" }
      },
      "required": ["date", "totalCalories"]
    },
    "UserAchievement": {
      "title": "UserAchievement",
      "description": "Conquista desbloqueada ou progresso de metas do usuário",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "unlockedAt": { "type": "string", "maxLength": 50 },
        "progress": { "type": "number" },
        "currentValue": { "type": "number" },
        "targetValue": { "type": "number" }
      },
      "required": ["id", "progress"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Perfis individuais de usuários protegidos por UID"
    },
    "/users/{userId}/scans/{scanId}": {
      "schema": "ProductScan",
      "description": "Histórico de produtos escaneados isolados por usuário"
    },
    "/users/{userId}/dailyLogs/{date}": {
      "schema": "DailyLog",
      "description": "Registros de ingestão diária por data"
    },
    "/users/{userId}/achievements/{achievementId}": {
      "schema": "UserAchievement",
      "description": "Conquistas e medalhas do usuário"
    }
  }
}
